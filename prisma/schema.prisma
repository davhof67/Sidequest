generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String  @id @default(dbgenerated("gen_random_uuid()"))
  email String  @unique
  name  String?

  displayName  String
  passwordHash String
  avatarUrl    String?

  createdQuests Quest[] @relation("CreatedQuests")

  joinedQuests Quest[] @relation("QuestParticipants")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Quest {
  id             String   @id @default(dbgenerated("gen_random_uuid()"))
  title          String
  description    String?
  published      Boolean  @default(false)
  author         User     @relation("CreatedQuests", fields: [authorId], references: [id], onDelete: Cascade)
  authorId       String
  maxParicipants Int
  participants   User[]   @relation("QuestParticipants")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
